# ---------- App ----------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- MongoDB Atlas ----------
# App user: readWrite on the teleshop database ONLY. Never use the Atlas admin user here.
MONGODB_URI=mongodb+srv://teleshop_app:<password>@<cluster>.mongodb.net/teleshop?retryWrites=true&w=majority
MONGODB_DB=teleshop

# ---------- Auth.js ----------
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Security ----------
# 32 random bytes, base64. Encrypts admin TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Upstash Redis (production rate limiting). Leave empty in dev to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Storage (Upstash Blob, ADR-005) ----------
# console.upstash.com → Blob → bucket "teleshop-images" (public). Free: 1 GB, 10 GB egress/month.
UPSTASH_BLOB_TOKEN=
# Seller documents are encrypted before upload (ADR-006): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCS_ENCRYPTION_KEY=

# ---------- Email ----------
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM="Teleshop <no-reply@teleshop.lk>"
