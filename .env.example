# ---------- App ----------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- MongoDB Atlas ----------
# App user: readWrite on the teleshop database ONLY. Never use the Atlas admin user here.
MONGODB_URI=mongodb+srv://teleshop_app:<password>@<cluster>.mongodb.net/teleshop?retryWrites=true&w=majority
MONGODB_DB=teleshop

# ---------- Auth.js ----------
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Security ----------
# 32 random bytes, base64. Encrypts admin TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Upstash Redis (production rate limiting). Leave empty in dev to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Storage (Upstash Blob, ADR-005) ----------
# console.upstash.com → Blob → bucket "teleshop-images" (public). Free: 1 GB, 10 GB egress/month.
UPSTASH_BLOB_TOKEN=
# Seller documents are encrypted before upload (ADR-006): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCS_ENCRYPTION_KEY=

# ---------- Scheduled jobs (Vercel Cron) ----------
# Vercel sends it to /api/cron/* as "Authorization: Bearer …". Empty = the jobs refuse to run.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------- Error reports (P8-T05) ----------
# Sentry project → Settings → Client Keys (DSN). Empty = errors go to the logs only.
# Every report is scrubbed (no emails, phones, addresses, tokens, IPs) — docs/10 §1.
SENTRY_DSN=
# Defaults to Vercel's environment (production / preview) or NODE_ENV.
SENTRY_ENVIRONMENT=

# ---------- Email ----------
# Brevo (free 300 emails/day): brevo.com → SMTP & API → API Keys → "Generate a new API key"
# (starts with xkeysib-). When set it is used instead of SMTP. Empty + no EMAIL_SERVER = no email.
BREVO_API_KEY=
# Only if BREVO_API_KEY holds an SMTP key (xsmtpsib-…): the SMTP login from the same page (…@smtp-brevo.com)
BREVO_SMTP_LOGIN=
# Alternative: any SMTP server as a URL, e.g. smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
EMAIL_SERVER=
# Must be a sender you verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
EMAIL_FROM="Teleshop <you@example.com>"
# Where /contact form messages are delivered (your real inbox). Empty = the public support address.
CONTACT_INBOX=
