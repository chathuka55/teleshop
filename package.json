{
  "name": "teleshop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:indexes": "tsx scripts/seed/indexes.ts",
    "db:migrate": "tsx scripts/seed/migrate.ts",
    "db:seed": "tsx scripts/seed/seed.ts",
    "db:set-password": "tsx scripts/seed/set-password.ts",
    "models:optimize": "gltf-transform optimize",
    "prepare": "husky",
    "test:watch": "vitest --project unit",
    "db:memory": "tsx scripts/dev/memory-db.ts",
    "vercel:preview-env": "node scripts/dev/vercel-preview-env.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@node-rs/argon2": "2.2.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.1",
    "@upstash/blob": "0.0.11",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "mongoose": "9.11.4",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.7",
    "otplib": "13.5.0",
    "postprocessing": "6.39.5",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "3.3.7",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
